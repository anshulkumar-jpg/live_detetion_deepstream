# Copy to .env and replace every CHANGE_ME. Never commit .env.
ENVIRONMENT=production
LOG_LEVEL=INFO
NODE_ID=gpu-node-1

# --- PostgreSQL
POSTGRES_USER=vms
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=vms

# --- Security
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
# password the GPU workers use to publish video to MediaMTX (publish only, no API access), at least 24 characters
# python -c "import secrets; print(secrets.token_urlsafe(32))"
MEDIAMTX_PUBLISH_TOKEN=CHANGE_ME_AT_LEAST_24_CHARS
# signs the commands the scheduler sends to GPU nodes; GPU agents refuse anything not signed with it (at least 32 chars)
# python -c "import secrets; print(secrets.token_urlsafe(48))"
COMMAND_SIGNING_KEY=CHANGE_ME_AT_LEAST_32_CHARS
# logins for the MediaMTX control API and its metrics, at least 24 characters (python scripts/make_mediamtx_secrets.py creates them)
MEDIAMTX_API_PASSWORD=CHANGE_ME_AT_LEAST_24_CHARS
MEDIAMTX_METRICS_PASSWORD=CHANGE_ME_AT_LEAST_24_CHARS
# raw camera streams put the camera password into MediaMTX: keep false unless you really need them
ALLOW_RAW_STREAMS=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
TLS_CERT_DIR=./deploy/envoy/certs
PUBLIC_BASE_URL=https://vms.example.internal:8443
PUBLIC_RTSP_URL=rtsp://vms.example.internal:8554

# --- Kafka (enable SASL/TLS for multi-host deployments)
KAFKA_DEFAULT_PARTITIONS=12
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# --- Scheduling & GPU admission control
CAMERAS_PER_WORKER=2
# Conservative cap until scripts/benchmark.py has recorded a measured capacity profile
DEFAULT_MAX_STREAMS_PER_GPU=8
DEFAULT_STREAM_MEMORY_MB=350
GPU_MAX_UTILIZATION_PCT=85
GPU_MAX_MEMORY_PCT=90
GPU_MAX_DECODER_PCT=85
GPU_MAX_ENCODER_PCT=85
GPU_MAX_TEMPERATURE_C=85
GPU_MAX_INFERENCE_LATENCY_MS=200
GPU_MEMORY_RESERVE_MB=1024

# --- DeepStream worker
MODEL_REPOSITORY_HOST_DIR=./models
DETECTION_EVENT_INTERVAL_FRAMES=15
EMBEDDING_INTERVAL_FRAMES=30
EVENTS_MAX_PER_SECOND_PER_CAMERA=60
STREAMMUX_WIDTH=1920
STREAMMUX_HEIGHT=1080
RTSP_RECONNECT_INTERVAL_S=10
RTSP_LATENCY_MS=200
ENCODER_BITRATE_BPS=4000000
STREAM_PUSH_PROTOCOL=rtsp

# --- Analytics
EMBEDDING_DIM=256
MTMC_MATCH_THRESHOLD=0.75
MTMC_TIME_WINDOW_S=600
EMBEDDING_RETENTION_DAYS=7
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Elasticsearch / Kibana / Logstash logins (analytics profile). `python scripts/vms.py init` generates all CHANGE_ME secrets.
ELASTIC_PASSWORD=CHANGE_ME
KIBANA_SYSTEM_PASSWORD=CHANGE_ME
LOGSTASH_ES_PASSWORD=CHANGE_ME
# Previous keys, only while rotating (see docs/SECRETS.md)
JWT_SECRET_PREVIOUS=
CREDENTIAL_ENCRYPTION_KEYS_OLD=
# Address(es) browsers use for WebRTC to this server, comma separated (e.g. 127.0.0.1,localhost,10.0.0.5)
WEBRTC_ADDITIONAL_HOSTS=127.0.0.1,localhost
# Retention (days, 0 = keep forever) of personal data - see docs/DATA_RETENTION.md
DETECTION_EVENT_RETENTION_DAYS=30
REID_RETENTION_DAYS=7
ANALYTICS_EVENT_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
