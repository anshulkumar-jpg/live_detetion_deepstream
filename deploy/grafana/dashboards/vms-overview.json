{
 "title": "DeepStream VMS - Overview",
 "uid": "vms-overview",
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "panels": [
  {
   "type": "stat",
   "title": "Registered cameras",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(vms_cameras)",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Running",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(vms_cameras{status=\"RUNNING\"})",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Pending capacity",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(vms_cameras{status=\"PENDING_CAPACITY\"})",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Failed / reconnecting",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(vms_cameras{status=~\"FAILED|RECONNECTING\"})",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Active workers",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(vms_workers{state=~\"RUNNING|DEGRADED|STARTING\"})",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Worker failures (24h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(increase(vms_worker_failures_total[24h]))",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "GPU utilisation",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "vms_gpu_utilization_pct",
     "legendFormat": "{{node}}/gpu{{gpu}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "GPU memory",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "decmbytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "vms_gpu_memory_used_mb",
     "legendFormat": "used {{node}}/gpu{{gpu}}",
     "refId": "A"
    },
    {
     "expr": "vms_gpu_memory_total_mb",
     "legendFormat": "total {{node}}/gpu{{gpu}}",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "NVDEC / NVENC",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "vms_gpu_nvdec_utilization_pct",
     "legendFormat": "NVDEC {{node}}/gpu{{gpu}}",
     "refId": "A"
    },
    {
     "expr": "vms_gpu_nvenc_utilization_pct",
     "legendFormat": "NVENC {{node}}/gpu{{gpu}}",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "GPU temperature / power",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "vms_gpu_temperature_c",
     "legendFormat": "temp {{gpu}}",
     "refId": "A"
    },
    {
     "expr": "vms_gpu_power_w",
     "legendFormat": "W {{gpu}}",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Processing FPS per camera",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "vms_camera_processing_fps",
     "legendFormat": "{{camera}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Pipeline latency per camera",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "vms_pipeline_latency_ms",
     "legendFormat": "{{camera}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Frames below input FPS (dropped)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (camera) (rate(vms_camera_dropped_frames_total[5m]))",
     "legendFormat": "{{camera}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "GPU memory per worker",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "decmbytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "vms_worker_gpu_memory_mb",
     "legendFormat": "{{worker}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Kafka consumer lag",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 36,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag)",
     "legendFormat": "{{consumergroup}} {{topic}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "RTSP failures",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 36,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (camera) (increase(vms_rtsp_failures_total[10m]))",
     "legendFormat": "{{camera}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Re-ID latency p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 44,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(vms_reid_latency_seconds_bucket[5m])))",
     "legendFormat": "p95",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "MediaMTX readers",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 44,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (name) (paths_readers)",
     "legendFormat": "{{name}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "API latency p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 52,
    "w": 24,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, route) (rate(vms_api_request_seconds_bucket[5m])))",
     "legendFormat": "{{route}}",
     "refId": "A"
    }
   ]
  }
 ],
 "tags": [
  "vms",
  "deepstream"
 ]
}